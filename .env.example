# Copy to .env next to compose.yaml. The directory holding application.yaml and secrets.env.
# On Windows use forward slashes, for example C:/Users/you/.mcp-hub.
MCP_HUB_CONFIG=/home/you/.mcp-hub
# Optional. A released version such as 0.1.0 to stay on; the newest release when left out.
# MCP_HUB_VERSION=0.1.0
